; MY TOMORROW — Godot 4 project
; Stage 1 foundation: Android landscape, offline, Persian-first UI.

config_version=5

[application]
config/name="mytomorrow"
run/main_scene="res://scenes/main.tscn"

[autoload]
ProfileManager="*res://scripts/profile_manager.gd"
LifeSystem="*res://scripts/life_system.gd"
EconomySystem="*res://scripts/economy_system.gd"
SocialStory="*res://scripts/social_story.gd"
LifestyleSystem="*res://scripts/lifestyle_system.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=0

[rendering]
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.43, 0.62, 0.72, 1)

[physics]
3d/default_gravity=9.8

[application/run]
